# ─── BIMVORA FRONTEND ─────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# In EasyPanel / CI set these as environment variables (not committed to git).

# ── Public URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bimvora.com

# ── Backend API ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.bimvora.com

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key — NEVER expose to the browser, server-side only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe (add when ready) ────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (transactional email) ───────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@bimvora.com

# ── Analytics ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
